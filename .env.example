# ---------------------------------------------------------------------------
# Copy this file to .env and replace every value.
# Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL password (Coder control plane)
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The public URL people use to open Coder.
# Local test:  http://localhost:7080
# Production:  https://coder.example.com  (put a TLS reverse proxy in front)
CODER_ACCESS_URL=http://localhost:7080

# First Coder administrator, created by `make admin`.
CODER_ADMIN_USER=admin
CODER_ADMIN_EMAIL=admin@example.com
CODER_ADMIN_PASSWORD=replace-with-another-long-random-password

# Set true only if you want unauthenticated Magpie path-app URLs.
# This enables Coder's path-app sharing flag; read docs/security.md first.
CODER_ALLOW_PUBLIC_PATH_APPS=false
